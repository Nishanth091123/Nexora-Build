# ===== Nexora Build – environment variables =====
# Copy to .env and fill. NEVER commit .env to GitHub.

# App
APP_NAME=Nexora Build
OWNER_USERNAME=nishanth_s
OWNER_EMAIL=
OWNER_FULL_NAME=Nishanth S
OWNER_INITIAL_PASSWORD=
JWT_SECRET=change-me-to-a-long-random-string
DEFAULT_LANGUAGE=en
DEFAULT_STATE=Tamil Nadu
DEFAULT_SPEC_LEVEL=standard

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Cloudflare R2 (S3-compatible file storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nexora-build-files

# LLM providers (fallback order: Gemini -> Groq -> OpenRouter)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional: force a model (blank = automatic – the app picks a working free model)
GEMINI_VISION_MODEL=
GROQ_VISION_MODEL=
OPENROUTER_VISION_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
GEMINI_EMBED_MODEL=
GROQ_WHISPER_MODEL=

# Storage: db = files kept inside the database (default) | local | r2
STORAGE_BACKEND=db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Phase 7: your Vercel address (optional – *.vercel.app is already allowed)
ONLINE_APP_URL=
MAX_UPLOAD_MB=25
AUTO_BACKUP_HOURS=24

# Render: Settings -> Deploy Hook (secret link). github_push.bat uses it to deploy for you.
RENDER_DEPLOY_HOOK=
# your Render address (only if it is not https://nexora-build-api.onrender.com)
ONLINE_API_URL=

# 1.20 AI Render (free) – Cloudflare Workers AI: dash.cloudflare.com → AI → Workers AI → Use REST API
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Optional: Gemini image model name (blank = automatic; used only if Google gives your key free image quota)
GEMINI_IMAGE_MODEL=
